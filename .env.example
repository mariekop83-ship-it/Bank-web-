# Application Environment
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000

# Brand Configuration (Optional - Defaults to Meridian International Bank)
BRAND_NAME="Meridian International Bank"
BRAND_SHORT_NAME="Meridian Bank"
BRAND_SUPPORT_EMAIL="support@meridianbank.example"
BRAND_DOMAIN="meridianbank.example"

# External MySQL Database (Required for persistence and banking operations)
# Option A (Recommended): Paste a single MySQL connection URL (e.g. from Aiven, Railway, PlanetScale, SkySQL)
MYSQL_URL=
# Option B: Or specify individual MySQL fields if not using MYSQL_URL / DATABASE_URL
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_SSL=true
MYSQL_SSL_REJECT_UNAUTHORIZED=false
MYSQL_SSL_CA=
MYSQL_CONNECTION_LIMIT=10

# Security & Cryptography (Required in production; generate 64-hex or 32+ char random strings)
SESSION_SECRET=
JWT_SECRET=
ENCRYPTION_KEY=
COOKIE_DOMAIN=
TRUST_PROXY=true

# Initial Administrator Bootstrap
ADMIN_INITIAL_EMAIL=
ADMIN_SETUP_TOKEN=

# SMTP Email Notifications (Optional - required to send live emails)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Meridian International Bank <no-reply@meridianbank.example>"

# Financial & External Partner Integrations (Optional - integrations remain unavailable/sandbox until configured)
BANKING_PARTNER_PROVIDER=none
BANKING_PARTNER_API_KEY=
BANKING_PARTNER_WEBHOOK_SECRET=

PAYMENT_PROVIDER=none
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

FX_PROVIDER=none
FX_API_KEY=

CARD_ISSUER_PROVIDER=none
CARD_ISSUER_API_KEY=
CARD_ISSUER_WEBHOOK_SECRET=

KYC_PROVIDER=internal_review
KYC_PROVIDER_API_KEY=

SMS_PROVIDER=none
SMS_API_KEY=
SMS_FROM=

# Private Document Storage (Optional - defaults to encrypted database/private storage; do not expose publicly)
PRIVATE_STORAGE_DIR=
